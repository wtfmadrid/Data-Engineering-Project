    {
      "name": "top_10_products_revenue",
      "displayName": "Top 10 Products by Revenue",
      "queryLines": [
        "SELECT\n",
        "  product,\n",
        "  SUM(total_amount_cad) as total_revenue\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "GROUP BY\n",
        "  product\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "fmcg",
      "schema": "gold"
    },
    {
      "name": "top_10_customers_revenue",
      "displayName": "Top 10 Customers by Revenue",
      "queryLines": [
        "SELECT\n",
        "  customer,\n",
        "  SUM(total_amount_cad) as total_revenue,\n",
        "  SUM(sold_quantity) as total_quantity\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "WHERE\n",
        "  customer IS NOT NULL\n",
        "GROUP BY\n",
        "  customer\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "top_10_divisions_revenue",
      "displayName": "Top 10 Divisions by Revenue",
      "queryLines": [
        "SELECT\n",
        "  division,\n",
        "  SUM(total_amount_cad) as total_revenue\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "WHERE\n",
        "  division IS NOT NULL\n",
        "GROUP BY\n",
        "  division\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "top_10_categories_revenue",
      "displayName": "Top 10 Categories by Revenue",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  SUM(total_amount_cad) as total_revenue\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "WHERE\n",
        "  category IS NOT NULL\n",
        "GROUP BY\n",
        "  category\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ],
      "catalog": "fmcg",
      "schema": "gold"
    }
